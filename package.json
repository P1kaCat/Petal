{
  "name": "petal-launcher",
  "version": "0.2.0",
  "description": "Minecraft Java launcher with Modrinth, CurseForge, and moderated Petal mod hosting",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "author": "P1kaCat",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.25.0",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "api": "node api/server.cjs",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "dev.petal.launcher",
    "productName": "Petal",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/file-transfer": "1.0.6",
    "@xmcl/installer": "5.4.0",
    "msmc": "5.0.5",
    "nodemailer": "^10.0.14",
    "otplib": "^13.5.0",
    "undici": "6.0.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
